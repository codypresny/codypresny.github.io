      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link" href="index.html">Home</a></li>
          <li class="nav-item"><a class="nav-link active" href="gold-generator.html">Gold Generator</a></li>
          <li class="nav-item"><a class="nav-link active" href="MediaGallery.html">Media Gallery</a></li>
          <li class="nav-item"><a class="nav-link active" href="DiceRoller.html">Random Dice Generator</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container-main">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-6">
          <div class="card">
            <div class="card-body text-center">
              <i class="bi bi-coin icon-lg"></i>
              <h1 class="card-title mb-1">Gold Placement</h1>
              <p class="text-muted mb-4">Generate random gold configurations</p>
              <button onclick="generateGold()" class="btn btn-primary btn-lg mb-4">
                <i class="bi bi-coin"></i> Generate
              </button>

              <div class="result mt-4" id="output" style="display: none;">
                <div class="mb-3">
                  <small class="text-muted">Major Gold Position</small>
                  <div class="badge-gold" id="major-output"></div>
                </div>
                <div class="mb-3">
                  <small class="text-muted">Minor Gold Position</small>
                  <div class="badge-gold" id="minor-output"></div>
                </div>
                <div>
                  <small class="text-muted">No Gold Positions</small>
                  <p id="nogold-output" class="mb-0"></p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <footer>
    <small>&copy; 2026 GRUBSTAKE. All rights reserved.</small>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    const validConfigurations = [
      [1,2], [1,4],
      [2,1], [2,3], [2,4], [2,5],
      [3,2], [3,5], [3,6],
      [4,1], [4,2], [4,5], [4,7],
      [5,2], [5,3], [5,4], [5,6], [5,7], [5,8],
      [6,3], [6,5], [6,8], [6,9],
      [7,4], [7,5], [7,8],
      [8,5], [8,6], [8,7], [8,9],
      [9,6], [9,8]
    ];

    function generateGold() {
      // Build Major → Minor lookup
      const minorByMajor = {};
      validConfigurations.forEach(([M, m]) => {
        if (!minorByMajor[M]) minorByMajor[M] = [];
        minorByMajor[M].push(m);
      });

      // Uniform Major selection
      const majors = Object.keys(minorByMajor);
      const major = majors[Math.floor(Math.random() * majors.length)];

      // Valid Minor selection
      const minors = minorByMajor[major];
      const minor = minors[Math.floor(Math.random() * minors.length)];

      // No-gold positions
      const noGold = [];
      for (let i = 1; i <= 9; i++) {
        if (i != major && i != minor) noGold.push(i);
      }

      document.getElementById("major-output").textContent = `M: ${major}`;
      document.getElementById("minor-output").textContent = `m: ${minor}`;
      document.getElementById("nogold-output").innerHTML = `<strong>X:</strong> ${noGold.join(", ")}`;
      document.getElementById("output").style.display = "block";
    }
  </script>

